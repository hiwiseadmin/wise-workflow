{
    "name": "wiseadmin/wise-workflow",
    "description": "WiseAdmin Workflow Engine - 工作流引擎 v2.0",
    "version": "2.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "WiseAdmin",
            "email": "wiseadmin@126.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "wise\\workflow\\": "src/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\workflow\\test\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^6.0 || ^8.0",
        "topthink/think-orm": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.0",
        "mockery/mockery": ">=1.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "think": {
            "services": [
                "wise\\workflow\\Service"
            ],
            "config": {
                "wise-workflow": "config/wise-workflow.php"
            },
            "migrate-path": "database/migrations"
        }
    }
}
