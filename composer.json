{
    "name": "wiseadmin/wise-workflow",
    "description": "WiseAdmin 工作流引擎 — 支持流程定义、多实例流转、条件分支、超时处理与事件通知，内置状态机驱动",
    "homepage": "https://github.com/hiwiseadmin/wise-workflow",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "WiseAdmin Team",
            "email": "wiseadmin@126.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "wiseadmin/wise-support": "1.0.*"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.0",
        "mockery/mockery": ">=1.0"
    },
    "suggest": {
        "wiseadmin/wise-mcp": "将工作流定义以 MCP 工具暴露给外部 MCP 客户端"
    },
    "autoload": {
        "psr-4": {
            "wise\\workflow\\": "src/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\workflow\\test\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "think": {
            "services": [
                "wise\\workflow\\WorkflowServiceProvider"
            ],
            "config": {
                "wise-workflow": "config/wise-workflow.php"
            },
            "migrate-path": "database/migrations"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/docs",
            "/.github",
            "/phpunit.xml",
            "/.gitattributes",
            "/.gitignore",
            "/*.md",
            "!/README.md",
            "/qa/"
        ]
    }
}
